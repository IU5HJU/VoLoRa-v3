+// ---- V3 -------------------------------------------------------------------------------------------------------------------------------------------------------------
+// L'estensione dichiarata dal client nei suoi HELLO e KEEPALIVE: 'V' '3', revisione, capacita'. Il reflector risponde con la stessa estensione solo a lui.
+void ReflectorCore::learnV3(Client& c) {
+  const uint8_t* e = c.link->peerExtension();
+  if (c.link->peerExtensionLen() >= 4 && e[0] == 'V' && e[1] == '3') {
+    if (!c.v3) say(std::string("client ") + c.name + " dichiara il V3");
+    c.v3 = true;
+    c.v3Caps = e[3];
+    const uint8_t mine[4] = {'V', '3', kV3Revision, static_cast<uint8_t>(kV3CapFrames | kV3CapDirectory)};
+    c.link->setStatusExtension(mine, sizeof(mine));
+  } else {
+    c.v3 = false;
+    c.v3Caps = 0;
+    c.link->setStatusExtension(nullptr, 0);
+  }
+}
+
+void ReflectorCore::sendEsito(Client& to, const uint8_t* dest, uint8_t code) {
+  uint8_t f[2 + kV3CallBytes + 1], out[kNodeMaxDatagram];
+  f[0] = kV3FrameByte0;
+  f[1] = kV3SubEsito;
+  memcpy(f + 2, dest, kV3CallBytes);
+  f[2 + kV3CallBytes] = code;
+  const size_t k = to.link->makePacket(f, sizeof(f), out, sizeof(out));
+  if (k && to.haveEndpoint) net_.send(to.endpoint, out, k);
+}
+
+// Limiti di velocita' e di byte per client V3. true = si puo' procedere.
+bool ReflectorCore::v3Allow(Client& c, bool inoltro, size_t bytes, uint32_t nowMs) {
+  auto& l = c.lim;
+  if (!l.started) {
+    l.started = true;
+    l.rateStart = l.byteStart = nowMs;
+  }
+  if (nowMs - l.rateStart >= kV3RateWindowMs) {
+    l.rateStart = nowMs;
+    l.inoltro = l.annuncio = 0;
+  }
+  if (nowMs - l.byteStart >= kV3ByteWindowMs) {
+    l.byteStart = nowMs;
+    l.bytes = 0;
+  }
+  if (inoltro) {
+    if (l.inoltro >= kV3MaxInoltroPerWindow || l.bytes + bytes > kV3MaxBytesPerWindow) return false;
+    l.inoltro++;
+    l.bytes += static_cast<uint32_t>(bytes);
+  } else {
+    if (l.annuncio >= kV3MaxAnnuncioPerWindow) return false;
+    l.annuncio++;
+  }
+  return true;
+}
+
+void ReflectorCore::onV3(Client& c, const uint8_t* d, size_t n, uint32_t nowMs) {
+  if (!c.v3 || n < 2 || d[0] != kV3FrameByte0) {  // un client v2 non puo' inserire frame V3; gli altri frame V3 non sono del reflector
+    stats_.v3Refused++;
+    return;
+  }
+  const uint8_t sub = d[1];
+  if (sub == kV3SubAnnuncio) {
+    // conteggio (1), poi per ogni stazione: nominativo compatto (6) e eta' in secondi (2)
+    if (n < 3) {
+      stats_.v3Refused++;
+      return;
+    }
+    const size_t count = d[2];
+    if (count > kV3MaxDirectory || n < 3 + 8 * count) {
+      stats_.v3Refused++;
+      return;
+    }
+    if (!v3Allow(c, false, n, nowMs)) {
+      stats_.v3RateLimited++;
+      return;
+    }
+    c.dir.clear();
+    for (size_t i = 0; i < count; i++) {
+      const uint8_t* e = d + 3 + 8 * i;
+      Client::DirEntry en;
+      memcpy(en.call, e, kV3CallBytes);
+      en.seenMs = static_cast<int64_t>(nowMs) - static_cast<int64_t>((e[6] << 8) | e[7]) * 1000;
+      c.dir.push_back(en);
+    }
+    stats_.v3Announces++;
+    return;
+  }
+  if (sub == kV3SubInoltro) {
+    // destinazione (6), origine (6), ttl (1), frame V3 (resto)
+    if (n < 2 + 2 * kV3CallBytes + 1) {
+      stats_.v3Refused++;
+      return;
+    }
+    const uint8_t* dest = d + 2;
+    const uint8_t ttl = d[2 + 2 * kV3CallBytes];
+    if (!v3Allow(c, true, n, nowMs)) {
+      stats_.v3RateLimited++;
+      sendEsito(c, dest, kV3EsitoRifiutato);
+      return;
+    }
+    // un OFFER con un oggetto oltre il tetto non passa (come la radio): hdr 4, nominativo (1 + N), tipo oggetto (1), dimensione (3)
+    const uint8_t* inner = d + 3 + 2 * kV3CallBytes;
+    const size_t innerLen = n - (3 + 2 * kV3CallBytes);
+    if (innerLen >= 6 && inner[0] == kV3InnerOffer) {
+      const size_t sz = 5 + static_cast<size_t>(inner[4]) + 1;
+      if (innerLen >= sz + 3) {
+        const uint32_t objSize = (static_cast<uint32_t>(inner[sz]) << 16) | (static_cast<uint32_t>(inner[sz + 1]) << 8) | inner[sz + 2];
+        if (objSize > kV3MaxObjectBytes) {
+          stats_.v3TooBig++;
+          sendEsito(c, dest, kV3EsitoRifiutato);
+          return;
+        }
+      }
+    }
+    Client* best = nullptr;
+    int64_t bestSeen = 0;
+    for (auto& o : clients_) {
+      if (o->id == c.id || !o->v3 || !o->haveEndpoint || !o->link->linkUp(nowMs)) continue;
+      for (const auto& en : o->dir) {
+        const int64_t age = static_cast<int64_t>(nowMs) - en.seenMs;
+        if (memcmp(en.call, dest, kV3CallBytes) == 0 && age <= kV3DirectoryLifeMs && (!best || en.seenMs > bestSeen)) {
+          best = o.get();
+          bestSeen = en.seenMs;
+        }
+      }
+    }
+    if (ttl == 0 || !best) {
+      sendEsito(c, dest, ttl == 0 ? kV3EsitoRifiutato : kV3EsitoNonTrovato);
+      return;
+    }
+    uint8_t f[kNodeMaxPayload], out[kNodeMaxDatagram];
+    memcpy(f, d, n);
+    f[2 + 2 * kV3CallBytes] = static_cast<uint8_t>(ttl - 1);
+    const size_t k = best->link->makePacket(f, n, out, sizeof(out));
+    if (!k) {
+      sendEsito(c, dest, kV3EsitoRifiutato);
+      return;
+    }
+    net_.send(best->endpoint, out, k);
+    best->packetsOut++;
+    stats_.v3Forwarded++;
+    sendEsito(c, dest, kV3EsitoConsegnato);
+    return;
+  }
+  stats_.v3Refused++;  // l'esito lo manda solo il reflector; altri sottotipi non si instradano
+}
